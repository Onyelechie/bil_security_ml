# ==========================
# Server
# ==========================
DATABASE_URL=sqlite:///./server.db
HOST=127.0.0.1
PORT=8000
DEBUG=false

# WebSocket alert ingestion / storage
WS_MAX_CONNECTIONS=1000
WS_ALERT_QUEUE_SIZE=5000
WS_ALERT_WORKER_COUNT=4
WS_MAX_IMAGE_BYTES=5000000
WS_IMAGE_STORAGE_DIR=storage/ws_alert_images
WS_IMAGE_RETENTION_HOURS=24
WS_IMAGE_CLEANUP_INTERVAL_HOURS=24
LOG_BUFFER_MAX_ENTRIES=5000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Server security
SECRET_KEY=change-this-secret-key
ADMIN_PASSWORD=change-this-admin-password

# ==========================
# Edge identity / auth
# ==========================
SITE_ID=site_demo
SITE_NAME=Demo Site

EDGE_PC_ID=edge_demo
DEVICE_ID=edge_demo
DEVICE_PRIVATE_KEY_B64=WZ5W2u7F1LztSO/NhHrCO2AMbN/mic1cJsRdsz5jc/U=

# Edge -> server
SERVER_BASE_URL=http://127.0.0.1:8000

# Timers
HEARTBEAT_INTERVAL_SEC=60
UPDATE_INTERVAL_SEC=300
RETRY_INTERVAL_SEC=30

# Logging
LOG_LEVEL=INFO

# Offline queue
OFFLINE_QUEUE_DIR=storage/offline_queue
QUEUE_QUARANTINE_RETENTION_DAYS=7
SHARED_STORAGE_ROOT=storage/ws_alert_images

# ==========================
# Motion source toggles
# ==========================
ENABLE_TCP_MOTION=false
ENABLE_LOCAL_MOTION=true

# ==========================
# TCP motion input
# ==========================
TCP_HOST=0.0.0.0
TCP_PORT=8127

# ==========================
# RTSP ingest
# ==========================
RTSP_URL_LOW="rtsp://admin:LiveCamera1@192.168.2.50:8554/Streaming/Channels/102"
RING_BUFFER_SECONDS=25
ANALYSIS_FPS=5.0
FRAME_WIDTH=640
FRAME_HEIGHT=360

# ==========================
# Local motion
# ==========================
MOTION_FPS=1.0
MOTION_PIXEL_DELTA=15
MOTION_THRESHOLD=0.005
DEFAULT_CAMERA_ID=1

# ==========================
# Incident / extraction
# ==========================
TRIGGER_COOLDOWN_SEC=10
TRIGGER_MERGE_WINDOW_SEC=2.0

INCIDENT_QUIET_SEC=2.0
INCIDENT_MAX_SEC=12.0
INCIDENT_TICK_INTERVAL_SEC=0.2

WINDOW_PRE_SEC=1.5
WINDOW_POST_SEC=4.0
WINDOW_TARGET_FPS=5.0
WINDOW_MAX_FRAMES=40
WINDOW_WAIT_GRACE_SEC=1.5

# ==========================
# Detector
# ==========================
DETECTOR_MODEL=YOLOv8-Small
DETECTOR_WEIGHTS=
DETECTOR_PERSON_CONF=0.30
DETECTOR_VEHICLE_CONF=0.20
DETECTOR_ALLOWED_CLASSES=person,vehicle

# ==========================
# Direct CCTV sample runner
# ==========================
SAMPLE_CAMERA_ID=1
SAMPLE_WINDOW_SEC=2.0
SAMPLE_STRIDE_SEC=2.0
SAMPLE_TARGET_FPS=5.0
SAMPLE_MAX_FRAMES=30

# ==========================
# Edge HTTP API
# ==========================
EDGE_HTTP_HOST=127.0.0.1
EDGE_HTTP_PORT=8128

# Normalized polygons in JSON
# Include means only these areas count for motion
# Exclude means these areas are ignored
MOTION_INCLUDE_POLYGONS=[[[0.00,0.00],[0.10,0.00],[0.10,0.10],[0.00,0.10]]]
MOTION_EXCLUDE_POLYGONS=[]

PTZ_GLOBAL_MOTION_THRESHOLD=0.35
PTZ_CONSECUTIVE_FRAMES=2
PTZ_SUPPRESS_SEC=3.0